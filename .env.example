## ==================================================================
## VARIÁVEIS DE AMBIENTE - Nutra (API + Frontend + DB + Redis)
## ==================================================================
## Copie para .env: cp .env.example .env
## Diretório no servidor: /opt/nutra/
## ==================================================================

## ── GERAL ──────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost
ASPNETCORE_ENVIRONMENT=Production
GITHUB_OWNER=seu-usuario-github
NUTRA_TAG=latest
NUTRA_FRONTEND_TAG=latest

## ── BANCO DE DADOS (PostgreSQL) ────────────────────────────────────
NUTRA_DB_NAME=nutra_db
NUTRA_DB_USER=nutra_user
NUTRA_DB_PASSWORD=SUA_SENHA_FORTE_NUTRA_DB
NUTRA_DB_PORT=5433

## ── NUTRA API (OAuth) ─────────────────────────────────────────────
## Credenciais registradas no shark-lock (web-auth)
NUTRA_OAUTH_CLIENT_ID=nutra-api
NUTRA_OAUTH_CLIENT_SECRET=segredo-super-confidencial-nutra

## ── REDIS (Sessões NextAuth) ───────────────────────────────────────
REDIS_PORT=6379
REDIS_PASSWORD=redis-dev-password

## ── NUTRA FRONTEND (NextAuth + OIDC) ──────────────────────────────
## Gere com: openssl rand -base64 32
NUTRA_FRONTEND_NEXTAUTH_SECRET=GERE_UMA_CHAVE_FORTE_AQUI
## OAuth client registrado no shark-lock para o nutra-frontend
NUTRA_FRONTEND_OIDC_CLIENT_ID=nutra-http
NUTRA_FRONTEND_OIDC_CLIENT_SECRET=SEGREDO_DO_CLIENT_NUTRA_FRONTEND
