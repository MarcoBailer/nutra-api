## ==================================================================
## VARIÁVEIS DE AMBIENTE - Nutra (API + Frontend + DB)
## ==================================================================
## Copie para .env: cp .env.example .env
## Diretório no servidor: /opt/nutra/
##
## Em produção este arquivo é GERADO pelo CI do repo NutraApi (repo lead),
## a partir dos GitHub Secrets. Editar à mão só faz sentido para testes locais.
## ==================================================================

## ── GERAL ──────────────────────────────────────────────────────────
## URL pública, SEM barra no final. O compose deriva as variantes:
##   Authority da API  = ${APP_BASE_URL}/   (com barra, para casar o iss do token)
##   OIDC_ISSUER front = ${APP_BASE_URL}    (sem barra, monta o /.well-known/...)
##   AUTH_URL front    = ${APP_BASE_URL}/nutra-app/api/auth
APP_BASE_URL=https://seu-host.ts.net
ASPNETCORE_ENVIRONMENT=Production
GITHUB_OWNER=seu-usuario-github
NUTRA_TAG=latest
NUTRA_FRONTEND_TAG=latest

## ── BANCO DE DADOS (PostgreSQL 16) ─────────────────────────────────
## Só a nutra-api alcança este banco (rede interna, sem porta no host).
NUTRA_DB_NAME=nutra_db
NUTRA_DB_USER=nutra_user
NUTRA_DB_PASSWORD=SUA_SENHA_FORTE_NUTRA_DB

## ── NUTRA API (validação de JWT) ───────────────────────────────────
## A API só VALIDA tokens (JwtBearer) — não é cliente OAuth, não tem secret.
## Audience precisa ser igual ao Resource do scope registrado no shark-lock,
## que é o mesmo scope pedido pelo frontend em src/lib/auth.ts.
NUTRA_API_AUDIENCE=projeto-nutra-api

## ── NUTRA FRONTEND (Auth.js v5 + OIDC) ─────────────────────────────
## Gere com: openssl rand -base64 32
NUTRA_FRONTEND_AUTH_SECRET=GERE_UMA_CHAVE_FORTE_AQUI
## Client OAuth confidencial registrado no shark-lock para o nutra-frontend.
## Redirect URI: ${APP_BASE_URL}/nutra-app/api/auth/callback/nutra
NUTRA_FRONTEND_OIDC_CLIENT_ID=nutra-http
NUTRA_FRONTEND_OIDC_CLIENT_SECRET=SEGREDO_DO_CLIENT_NUTRA_FRONTEND
